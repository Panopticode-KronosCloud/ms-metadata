<!-- Use https://spotbugs.readthedocs.io/en/latest/filter.html#complete-example as reference for this document -->

<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Exclude all generated code -->
    <Match>
        <Class name="~com\.panopticode\.jooq\..*"/>
    </Match>

    <Match>
        <Class name="~com\.panopticode\.openapi\..*"/>
    </Match>

    <!-- Suppress EI_EXPOSE_REP2 "May expose internal representation" in constructors -->
    <Match>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2" />

    </Match>

    <!-- All bugs in test classes, except for JUnit-specific bugs -->
    <Match>
        <Class name="~.*\.*Test" />
        <Not>
            <Bug code="IJU" />
        </Not>
    </Match>
</FindBugsFilter>