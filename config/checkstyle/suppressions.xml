<suppressions>
    <!-- suppress checks on generated files -->
    <suppress files="src[\\/]main[\\/]java[\\/]generated[\\/].+" checks=".*"/>
    <!-- suppress or customise some checks on test files -->
    <suppress files="src[\\/][a-z]*[tT]est[\\/].+" id="MagicNumberProd"/>
    <suppress files="src[\\/][a-z]*[tT]est[\\/].+" id="MissingCtorProd"/>
    <suppress files="src[\\/][a-z]*[tT]est[\\/].+" id="MissingJavadocTypeProd"/>
    <suppress files="src[\\/][a-z]*[tT]est[\\/].+" id="NonPrivateMemberNameProd"/>
    <suppress files="src[\\/][a-z]*[tT]est[\\/].+" checks="MultipleStringLiterals"/>
    <suppress files="src[\\/]main[\\/]java[\\/]com[\\/]panopticode[\\/].+" checks="TestMethodName"/>
</suppressions>